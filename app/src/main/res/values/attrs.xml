<?xml version="1.0" encoding="utf-8"?>
<resources>
<!--    버튼 디자인-->
    <declare-styleable name="GradientTextButton">
        <attr name="gtb_text" format="string" />
        <attr name="gtb_textColor" format="color" />
        <attr name="gtb_textSize" format="dimension" />
        <attr name="gtb_background" format="reference|color" />
        <attr name="gtb_allCaps" format="boolean" />
        <attr name="gtb_textStyle" format="enum">
            <enum name="normal" value="0"/>
            <enum name="bold" value="1"/>
            <enum name="italic" value="2"/>
        </attr>
        <attr name="gtb_paddingHorizontal" format="dimension" />
        <attr name="gtb_minHeight" format="dimension" />

        <!-- 시작(왼쪽) 아이콘 -->
        <attr name="ciIcon" format="reference"/>
        <!-- 아이콘 색 -->
        <attr name="ciIconTint" format="color|reference"/>
        <!-- 아이콘 크기(px/dp) - 지정 안 하면 intrinsic 크기 사용 -->
        <attr name="ciIconSize" format="dimension"/>
        <!-- 텍스트와 아이콘 사이 간격 -->
        <attr name="ciIconPadding" format="dimension"/>
    </declare-styleable>

    <!--  타이틀 바 -->
    <declare-styleable name="TitleBarView">
        <attr name="titleText" format="string" />
        <attr name="showBack" format="boolean" />
    </declare-styleable>

</resources>

