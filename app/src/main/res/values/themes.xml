<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MessageApp" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 앱 실제 테마 -->
    <style name="Theme.MessageApp" parent="Base.Theme.MessageApp">
        <item name="colorPrimary">@color/color_white</item>
        <item name="colorPrimaryDark">@color/color_navy_primary</item>
        <item name="colorAccent">@color/color_navy_primary</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="colorAccent">@color/color_navy_primary</item>


        <!-- Status bar (상단) -->
        <item name="android:statusBarColor">@color/color_navy_primary</item>
        <item name="android:windowLightStatusBar">true</item> <!-- 아이콘 어두운색 -->

        <!-- Navigation bar (하단, 제스처/버튼 영역) -->
        <item name="android:navigationBarColor">@color/color_navy_primary</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>