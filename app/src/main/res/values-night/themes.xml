<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Base.Theme.MessageApp" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
    </style>
    
    <!-- Base application theme. -->
    <style name="Theme.MessageApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimary">@color/color_navy_primary</item>
        <item name="colorPrimaryDark">@color/color_navy_primary</item>
        <item name="colorAccent">@color/color_navy_primary</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <!-- Status bar (상단) -->
        <item name="android:statusBarColor">@color/color_navy_primary</item>
        <item name="android:windowLightStatusBar">false</item> <!-- 아이콘 밝은색 -->

        <!-- Navigation bar (하단, 제스처/버튼 영역) -->
        <item name="android:navigationBarColor">@color/color_navy_primary</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!-- 앱 실제 테마 -->
</resources>