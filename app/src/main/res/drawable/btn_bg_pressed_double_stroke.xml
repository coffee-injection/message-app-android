<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 바깥 테두리(두꺼운 1색) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_transparent"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/blue_300"/>
        </shape>
    </item>

    <!-- 안쪽 테두리(살짝 들어간 1색) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">
            <solid android:color="@color/color_transparent"/>
            <!-- 바깥 stroke(2dp) + inset(1dp) 고려해서 radius 줄이기 -->
            <corners android:radius="15dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/btn_primary"/>
        </shape>
    </item>

</layer-list>
