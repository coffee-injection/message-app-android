<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MessageApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_white</item>
        <item name="colorPrimaryDark">@color/color_black</item>
        <item name="colorAccent">@color/color_navy_primary</item>

        <!-- Status bar (상단) -->
        <item name="android:statusBarColor">@color/color_black</item>
        <item name="android:windowLightStatusBar">false</item> <!-- 아이콘 밝은색 -->

        <!-- Navigation bar (하단, 제스처/버튼 영역) -->
        <item name="android:navigationBarColor">@color/color_black</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>