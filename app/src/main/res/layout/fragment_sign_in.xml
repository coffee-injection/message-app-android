<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fitsSystemWindows="true"
    tools:context="com.coffeeinjection.presentation.sign_in.SignInFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sign_in_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_island"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="150dp"
            android:src="@drawable/ic_island_daytime"
            app:layout_constraintBottom_toTopOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/black_title_normal24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Tium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_island" />

        <TextView
            android:id="@+id/tv_sub_title"
            style="@style/grey_second_title_normal14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sign_in_sub_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <com.coffeeinjection.message.util.GradientTextButton
            android:id="@+id/btn_google"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/btn_background_white"
            android:drawableStart="@drawable/ic_google"
            android:text="@string/sign_in_google"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toTopOf="@id/btn_kakao" />

        <com.coffeeinjection.message.util.GradientTextButton
            android:id="@+id/btn_kakao"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginBottom="130dp"
            android:background="@drawable/btn_background_kakao"
            android:drawableStart="@drawable/ic_kakao"
            android:text="@string/sign_in_kakao"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toTopOf="@id/tv_description" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="@string/sign_in_description"
            android:textColor="@color/text_quaternary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"
        android:visibility="gone" />

    <!-- 검정색 인디터미넌트 프로그레스바 (중앙 오버레이) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:visibility="gone"
        android:indeterminate="true"
        android:indeterminateTint="@android:color/black"
        android:indeterminateTintMode="src_in"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
