<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_navy"
    tools:context="com.coffeeinjection.presentation.sign_in.SignInFragment">

    <ImageView
        android:id="@+id/btn_a"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="60dp"
        android:background="@drawable/btn_gradient_navy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btn_a"
        app:layout_constraintBottom_toBottomOf="@id/btn_a"
        app:layout_constraintStart_toStartOf="@id/btn_a"
        app:layout_constraintEnd_toEndOf="@id/btn_a"
        android:textColor="@color/white"
        android:text="버튼이에요"/>


</androidx.constraintlayout.widget.ConstraintLayout>