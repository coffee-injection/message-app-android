<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.home.HomeFragment">

    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_daytime"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_island"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_island"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/ic_island_daytime"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.9"
            android:background="@drawable/bg_white_round_max"
            app:layout_constraintBottom_toBottomOf="@id/tv_island"
            app:layout_constraintEnd_toEndOf="@id/tv_island"
            app:layout_constraintStart_toStartOf="@id/tv_island"
            app:layout_constraintTop_toTopOf="@id/tv_island" />

        <TextView
            android:id="@+id/tv_island"
            style="@style/context_normal14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:paddingHorizontal="15dp"
            android:paddingVertical="9dp"
            android:text="도마도"
            app:layout_constraintBottom_toBottomOf="@id/iv_island"
            app:layout_constraintEnd_toEndOf="@id/iv_island"
            app:layout_constraintStart_toStartOf="@id/iv_island" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/cv_profile_img"
        app:cardBackgroundColor="@color/color_white"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:elevation="8dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_profile_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile1" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_user_name"
        style="@style/white_body_normal18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="등대지기"
        app:layout_constraintStart_toEndOf="@+id/cv_profile_img"
        app:layout_constraintTop_toTopOf="@+id/cv_profile_img" />

    <TextView
        android:id="@+id/tv_current_state"
        style="@style/white_body_normal16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="3dp"
        android:gravity="center"
        android:alpha="0.8"
        android:text="12월 6일 • 받은 메시지 2개"
        app:layout_constraintBottom_toBottomOf="@+id/cv_profile_img"
        app:layout_constraintStart_toEndOf="@+id/cv_profile_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name" />

    <ImageView
        android:id="@+id/btn_send_msg"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/fab_write"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 아이콘 뿌릴 레이어 (투명) -->
    <FrameLayout
        android:id="@+id/bg_SeaLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="300dp"
        app:layout_constraintTop_toTopOf="@id/layout_island"
        app:layout_constraintBottom_toTopOf="@id/btn_send_msg"
        app:layout_constraintStart_toStartOf="@id/iv_background"
        app:layout_constraintEnd_toEndOf="@id/iv_background"/>

</androidx.constraintlayout.widget.ConstraintLayout>