<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:padding="20dp">

    <!-- bg_letter는 안쪽 컨테이너에 주는 쪽이 안전 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/letterContainer"
        android:layout_width="0dp"
        android:layout_height="510dp"
        android:background="@drawable/bg_letter"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <!-- 닫기 버튼 -->
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 읽기 전용-->
        <TextView
            android:id="@+id/tv_content"
            style="@style/black_medium_normal16"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:overScrollMode="ifContentScrolls"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tvCharCount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivClose" />

        <!-- 쓰기 전용 -->
        <EditText
            android:id="@+id/etMessage"
            style="@style/black_medium_normal16"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="메시지를 입력하세요 (최대 1000자)"
            android:inputType="textMultiLine|textNoSuggestions"
            android:overScrollMode="ifContentScrolls"
            android:padding="12dp"
            android:textColorHint="@color/bg_secondary"
            app:layout_constraintBottom_toBottomOf="@+id/tvCharCount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivClose" />

        <!-- 글자 수 카운트 -->
        <TextView
            android:id="@+id/tvCharCount"
            style="@style/grey_medium_normal12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="0 / 1000"
            android:textSize="12sp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/tv_sender_name"
            app:layout_constraintEnd_toEndOf="@+id/tv_sender_name" />

        <TextView
            android:id="@+id/tv_sender_name"
            style="@style/black_medium_normal16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/dialog_fragment_message_island_name"
            app:layout_constraintBottom_toBottomOf="@+id/tv_sender"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_sender"
            style="@style/black_medium_normal16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_fragment_message_sender"
            android:textSize="16sp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/btnSend"
            app:layout_constraintEnd_toStartOf="@+id/tv_sender_name" />

        <com.coffeeinjection.message.util.GradientTextButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/btn_round_navy"
            android:drawableStart="@drawable/ic_send"
            android:gravity="center_vertical|center_horizontal"
            android:paddingStart="@dimen/text_size_16"
            android:paddingEnd="@dimen/text_size_16"
            android:text="@string/dialog_fragment_message"
            android:textAlignment="center"
            android:textColor="@color/color_white"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
