<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/guideFragment">

    <fragment
        android:id="@+id/guideFragment"
        android:name="com.coffeeinjection.message.presentation.guide.GuideFragment"
        android:label="fragment_guide"
        tools:layout="@layout/fragment_guide" >
        <action
            android:id="@+id/action_guideFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.coffeeinjection.presentation.sign_in.SignInFragment"
        android:label="fragment_sign_in"
        tools:layout="@layout/fragment_sign_in">
        <action
            android:id="@+id/action_signInFragment_to_userInfoFragment"
            app:destination="@id/userInfoFragment" />
        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.coffeeinjection.message.presentation.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_myPageFragment"
            app:destination="@id/myPageFragment" />
        <action
            android:id="@+id/action_homeFragment_to_messageDialogFragment"
            app:destination="@id/messageDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.coffeeinjection.message.presentation.mypage.fragment.MyPageFragment"
        android:label="fragment_mypage"
        tools:layout="@layout/fragment_mypage">
        <action
            android:id="@+id/action_myPageFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_bookmarkFragment"
            app:destination="@id/bookmarkFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_modifyUserInfoFragment"
            app:destination="@id/modifyUserInfoFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.coffeeinjection.message.presentation.setting.SettingFragment"
        android:label="SettingFragment">
        <argument
            android:name="docType"
            android:defaultValue="TERMS"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/bookmarkFragment"
        android:name="com.coffeeinjection.message.presentation.bookmark.BookmarkFragment"
        android:label="BookmarkFragment" />
    <dialog
        android:id="@+id/messageDialogFragment"
        android:name="com.coffeeinjection.message.presentation.dialog.MessageDialogFragment"
        android:label="messageDialogFragment">
        <argument
            android:name="letterId"
            app:argType="long" />

        <argument
            android:name="readOnly"
            android:defaultValue="false"
            app:argType="boolean" />

        <!--  진입 경로 -->
        <argument
            android:name="entry"
            app:argType="string"
            android:defaultValue="home" />

    </dialog>
    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.coffeeinjection.message.presentation.user_info.UserInfoFragment"
        android:label="UserInfoFragment"
        tools:layout="@layout/fragment_user_info" >
        <action
            android:id="@+id/action_userInfoFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <dialog
        android:id="@+id/modifyUserInfoFragment"
        android:name="com.coffeeinjection.message.presentation.user_info.ModifyUserInfoBottomSheetFragment"
        android:label="fragment_modify_user_info"
        tools:layout="@layout/fragment_modify_user_info" />
    <activity
        android:id="@+id/splashActivity"
        android:name="com.coffeeinjection.message.presentation.activity.SplashActivity"
        android:label="activity_splash"
        tools:layout="@layout/activity_splash" />
</navigation>